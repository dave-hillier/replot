{
  // Declaration-only build. Consumers resolve the "types" conditions in
  // package.json to dist/types, so they never typecheck replot's own sources
  // with their compiler options (see issue #135).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.ts", "src/**/*.tsx"]
}
