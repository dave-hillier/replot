{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "module": "Node16",
    "baseUrl": "./src",
    "jsx": "react-jsx",
    "paths": {
      "replot": ["index"],
      "replot/react": ["react/api"],
      "react": ["../node_modules/@types/react"],
      "react/jsx-runtime": ["../node_modules/@types/react/jsx-runtime"],
      "react-dom": ["../node_modules/@types/react-dom"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.js",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
