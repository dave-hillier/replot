{
  "name": "@dave-hillier/replot",
  "description": "A React port of Observable Plot: grammar-of-graphics charts as JSX components, rendered natively in the React tree.",
  "version": "0.1.0-alpha.1",
  "author": {
    "name": "Dave Hillier"
  },
  "license": "ISC",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "jsdelivr": "dist/replot.umd.min.js",
  "unpkg": "dist/replot.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "umd": "./dist/replot.umd.min.js",
      "default": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/types/react/api.d.ts",
      "default": "./dist/esm/react/api.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/types/index.d.ts",
  "keywords": [
    "react",
    "charts",
    "visualization",
    "dataviz",
    "d3",
    "plot",
    "observable-plot",
    "grammar-of-graphics",
    "svg",
    "jsx"
  ],
  "homepage": "https://dave-hillier.github.io/replot/",
  "bugs": {
    "url": "https://github.com/dave-hillier/replot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dave-hillier/replot.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/types/**/*.d.ts"
  ],
  "scripts": {
    "test": "yarn test:mocha && yarn test:tsc && yarn test:lint && yarn test:prettier && yarn test:smoke",
    "test:package": "yarn bundle && yarn test:publint && yarn test:attw",
    "test:publint": "npx --yes publint@^0.3.14 --strict --pack npm",
    "test:attw": "npx --yes @arethetypeswrong/cli@^0.18.2 --pack --profile esm-only",
    "test:coverage": "c8 yarn test:mocha",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:mocha": "mkdir -p test/output && TZ=America/Los_Angeles tsx node_modules/.bin/mocha 'test/**/*-test.*' 'test/plot.*'",
    "test:lint": "eslint src test",
    "test:prettier": "prettier --check src test",
    "test:tsc": "tsc",
    "build:types": "tsc -p tsconfig.build.json && node scripts/copy-declarations.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/copy-sources.mjs",
    "bundle": "vite build --config vite.bundle.config.ts && MINIFY=1 vite build --config vite.bundle.config.ts && yarn build:esm && yarn build:types",
    "prepublishOnly": "rm -rf dist && yarn bundle",
    "dev": "vite",
    "docs:dev": "tsx docs/scripts/ensure-bundle.ts && tsx docs/scripts/build-api-data.ts && vite --config docs/vite.docs.config.ts",
    "docs:build": "yarn bundle && tsx docs/scripts/build-api-data.ts && vite build --config docs/vite.docs.config.ts",
    "docs:preview": "vite preview --config docs/vite.docs.config.ts",
    "parity": "tsx scripts/parity.ts"
  },
  "sideEffects": [
    "./dist/esm/index.js"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@observablehq/runtime": "^6.0.0",
    "@observablehq/stdlib": "^5.8.8",
    "@shikijs/rehype": "^4.3.1",
    "@types/d3": "^7.4.0",
    "@types/mdx": "^2.0.13",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^5.1.4",
    "apache-arrow": "^19.0.0",
    "c8": "^10.1.3",
    "canvas": "^3.1.0",
    "d3-geo-projection": "^4.0.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "htl": "^0.3.0",
    "js-beautify": "1",
    "jsdom": "^26.0.0",
    "markdown-it-container": "^4.0.0",
    "mocha": "^11.1.0",
    "prettier": "~3.0.0",
    "publint": "^0.3.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "topojson-client": "^3.1.0",
    "ts-morph": "^25.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.0.2",
    "vite": "^6.1.0",
    "wouter": "^3.9.0"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.{js,ts,tsx}"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "d3": "^7.9.0",
    "interval-tree-1d": "^1.0.0",
    "isoformat": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
